page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #1a1a2e;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* ===== 详情子页面公共样式 ===== */
.sub-page {
  min-height: 100vh;
  background: #d9edf6;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  color: #8a8a99;
  padding: 120rpx 0;
}

.sec-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 93, 128, 0.08);
}

.sec-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1c5d80;
  padding-left: 20rpx;
  border-left: 8rpx solid #1c5d80;
  margin-bottom: 24rpx;
  line-height: 1.3;
}

.intro-p {
  font-size: 27rpx;
  color: #4a4a5a;
  line-height: 1.8;
  text-align: justify;
  margin-bottom: 16rpx;
}

.kv-line {
  font-size: 27rpx;
  color: #4a4a5a;
  line-height: 1.8;
}

.kv-note {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8a8a99;
  line-height: 1.7;
}

/* 日程列表 */
.schedule-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f5;
}

.schedule-item:last-child {
  border-bottom: none;
}

.schedule-time {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #1e5eff;
  font-weight: bold;
}

.schedule-title {
  font-size: 28rpx;
  font-weight: 500;
}

.schedule-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a8a99;
}

/* 通知列表 */
.notice-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f5;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1c5d80;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-title {
  flex: 1;
  font-size: 27rpx;
  color: #3a3a4a;
}

.notice-date {
  font-size: 23rpx;
  color: #b0b0bd;
  margin-left: 16rpx;
}

/* 主按钮 */
.btn-primary {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 44rpx;
  background: #1c5d80;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-primary::after {
  border: none;
}

.btn-primary.disabled {
  background: #b0b0bd;
}

/* 照片直播相册 */
.live-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.live-item {
  width: 48.5%;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(31, 93, 128, 0.08);
}

.live-cover {
  width: 100%;
  height: 200rpx;
  display: block;
}

.live-body {
  padding: 16rpx 20rpx 20rpx;
}

.live-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.live-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a99;
}
