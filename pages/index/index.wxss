.index-page {
  padding: 24rpx 24rpx 48rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 8rpx 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
}

.header-action {
  font-size: 26rpx;
  color: #8a8a99;
}

.loading,
.empty {
  text-align: center;
  color: #b0b0bd;
  padding: 120rpx 0;
  font-size: 28rpx;
}

.meeting-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meeting-item {
  padding: 28rpx 28rpx 24rpx;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  color: #fff;
}

.tag-open {
  background: #1e5eff;
}

.tag-prep {
  background: #ff9d00;
}

.tag-closed {
  background: #b0b0bd;
}

.item-short {
  font-size: 24rpx;
  color: #8a8a99;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.item-info {
  font-size: 26rpx;
  color: #6a6a7a;
  line-height: 1.7;
}

.item-arrow {
  margin-top: 16rpx;
  text-align: right;
  font-size: 26rpx;
  color: #1e5eff;
}
