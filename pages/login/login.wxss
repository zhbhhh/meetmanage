.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #1e5eff 0%, #4d8bff 30%, #f5f6fa 70%);
  padding-top: 160rpx;
  box-sizing: border-box;
}

.login-logo {
  width: 640rpx;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(30, 94, 255, 0.35);
}

.logo-img {
  width: 100%;
  height: 100%;
}

.login-title {
  margin-top: 60rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.login-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8a8a99;
}

.login-btn {
  margin-top: 120rpx;
  width: 640rpx;
  height: 96rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #1e5eff;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 1;
  text-align: center;
}

.login-btn::after {
  border: none;
}

.login-btn.disabled {
  opacity: 0.6;
}

.login-tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #b0b0bd;
}
